{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "displayName": "Windows x64 · Visual Studio 2022",
      "description": "Drogon и зависимости приходят из Conan v1. Сначала: scripts/build.ps1 -Configure",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-windows",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "${sourceDir}/build-windows/conan",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      }
    },
    {
      "name": "windows-msvc-ninja",
      "displayName": "Windows x64 · Ninja (быстрая пересборка)",
      "description": "Тот же Conan-каталог, но без MSBuild: нужен «x64 Native Tools Command Prompt»",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-windows-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build-windows/conan"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux · Release (Conan v1 в backend/build)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "jobs": 8
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "jobs": 8
    },
    {
      "name": "windows-ninja",
      "configurePreset": "windows-msvc-ninja",
      "jobs": 8
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-release",
      "configurePreset": "windows-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
