# Подключение к dev-БД. Скопировать в backend/.env (в git не попадает).
PGHOST=192.168.0.3
PGPORT=32770
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=reporting

# Роль только-чтения для данных отчётов (ADR-33). Создаётся скриптом scripts/db-ro.sh,
# пароль он дописывает сам. Без этих переменных данные читаются основной ролью.
REP_RO_DB_USER=reporting_ro
REP_RO_DB_PASSWORD=

# Аутентификация и роли (ADR-34). Пользователей создаёт scripts/auth-init.sh,
# пароли он дописывает сюда же. Без REP_AUTH=1 вход не требуется.
REP_AUTH=1
REP_SESSION_TTL_HOURS=12
REP_ADMIN_LOGIN=admin
REP_ADMIN_PASSWORD=
REP_VIEWER_LOGIN=viewer
REP_VIEWER_PASSWORD=

# Кэш результатов (ADR-32)
REP_CACHE_TTL_SECONDS=60
REP_CACHE_MAX_ENTRIES=200
REP_CACHE_MAX_BODY_BYTES=2097152
