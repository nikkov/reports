{
  "version": 2,
  "id": "sales-by-region",
  "title": "Продажи по региону",
  "params": [
    {
      "name": "region",
      "type": "select",
      "label": "Регион",
      "required": true,
      "source": {
        "kind": "lookup",
        "dataset": "region_lookup"
      }
    },
    {
      "name": "category",
      "type": "select",
      "label": "Категория",
      "source": {
        "kind": "lookup",
        "dependsOn": "region",
        "dataset": "category_lookup"
      }
    },
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2026-01-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-03-31",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "sales": {
      "params": {
        "region": "$region",
        "category": "$category",
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT s.region, s.category, s.product, s.amount, s.profit, s.order_date FROM reports_examples.sales s WHERE s.region_id = :region::int AND (:category = '' OR s.category = :category) AND s.order_date >= :from::date AND s.order_date <= :to::date ORDER BY s.category NULLS LAST, s.product, s.id",
      "connection": "main"
    },
    "region_lookup": {
      "connection": "main",
      "sql": "SELECT id::text AS value, name AS label FROM reports_examples.regions ORDER BY name"
    },
    "category_lookup": {
      "connection": "main",
      "sql": "SELECT DISTINCT s.category AS value, s.category AS label FROM reports_examples.sales s WHERE s.region_id = :region::int AND s.category IS NOT NULL ORDER BY 1"
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "Регион {{region}}, период {{from}} — {{to}}"
    },
    {
      "type": "table",
      "dataKey": "sales",
      "grandTotal": true,
      "columns": [
        {
          "field": "category",
          "title": "Категория",
          "group": true,
          "subtotal": true
        },
        {
          "field": "product",
          "title": "Продукт"
        },
        {
          "field": "amount",
          "title": "Сумма",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "profit",
          "title": "Прибыль",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Рентабельность",
          "expression": "sum(profit) / sum(amount)",
          "format": "percent"
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "sales",
      "chartType": "bar",
      "title": "Сумма по категориям",
      "xField": "category",
      "yField": "amount",
      "aggregate": "sum",
      "width": "full"
    }
  ],
  "folder": "Продажи",
  "tags": [
    "регионы",
    "параметры"
  ]
}
