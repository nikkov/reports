{
  "version": 2,
  "id": "totals-text",
  "title": "Текст в строках итогов",
  "description": "Свойство aggregateText (синоним aggregate_text) у колонки: в строках подытогов и общего итога печатается текст вместо суммы. «Средний чек» в итогах показывает «—», колонка «Комментарий» — «Итого по категории: <название>».",
  "params": [
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2026-01-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-03-31",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "sales": {
      "connection": "main",
      "params": {
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT coalesce(s.category, 'Без категории') AS category, r.name AS region, count(*) AS orders, sum(s.amount) AS amount FROM reports_examples.sales s JOIN reports_examples.regions r ON r.id = s.region_id WHERE s.order_date >= :from::date AND s.order_date <= :to::date GROUP BY 1, 2 ORDER BY 1, 3 DESC"
    }
  },
  "blocks": [
    {
      "type": "text",
      "span": 12,
      "text": "В строках итогов колонки ведут себя по-разному. «Заказов» и «Сумма» суммируются (aggregate), «Средний чек» печатает прочерк — средний по итогу не имеет смысла (aggregateText), «Комментарий» подставляет название категории через {value} в свой текст."
    },
    {
      "type": "table",
      "title": "Продажи по категориям",
      "dataKey": "sales",
      "span": 12,
      "grandTotal": true,
      "subtotalLabel": "Итого по категории: {value}",
      "grandTotalLabel": "Всего за период",
      "columns": [
        {
          "field": "category",
          "title": "Категория",
          "group": true,
          "subtotal": true
        },
        {
          "field": "region",
          "title": "Регион"
        },
        {
          "field": "orders",
          "title": "Заказов",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "amount",
          "title": "Сумма, руб.",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Средний чек, руб.",
          "expression": "sum(amount) / sum(orders)",
          "format": "number",
          "aggregateText": "—"
        },
        {
          "title": "Комментарий",
          "aggregate_text": "Итого по категории: {value}"
        }
      ]
    }
  ],
  "folder": "Оформление",
  "tags": [
    "итоги",
    "текст",
    "пример"
  ]
}
