{
  "version": 2,
  "id": "crm-filter-object",
  "title": "Цены: фильтр объектами и настройками",
  "description": "Тело POST: вложенный фильтр с массивом объектов, статические поля и скаляр из набора из одной строки.",
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    },
    "crm": {
      "kind": "rest",
      "baseUrl": "${CRM_BASE_URL}",
      "headers": {
        "Accept": "application/json"
      },
      "timeoutMs": 5000,
      "cacheSeconds": 30
    }
  },
  "datasets": {
    "categories": {
      "connection": "main",
      "sql": "SELECT (row_number() OVER (ORDER BY category))::int AS id_category, category FROM (SELECT DISTINCT category FROM reports_examples.sales) t ORDER BY category LIMIT 4"
    },
    "settings": {
      "connection": "main",
      "sql": "SELECT 'demo-tenant' AS tenant, 10 AS limit_rows"
    },
    "prices": {
      "connection": "crm",
      "rest": {
        "method": "POST",
        "path": "/api/prices",
        "body": {
          "version": 2,
          "tenant": "$settings.tenant",
          "filter": {
            "active": true,
            "categories": [
              {
                "id_category": "$categories.id_category",
                "name": "$categories.category"
              }
            ]
          },
          "options": {
            "limit": "$settings.limit_rows",
            "currency": "RUB"
          }
        },
        "rowsPath": "items",
        "columns": [
          {
            "field": "category_id",
            "type": "int",
            "title": "id"
          },
          {
            "field": "category",
            "type": "text",
            "title": "Категория"
          },
          {
            "field": "price",
            "type": "int",
            "title": "Цена"
          },
          {
            "field": "currency",
            "type": "text",
            "title": "Валюта"
          },
          {
            "field": "updated",
            "type": "date",
            "title": "Обновлено"
          }
        ],
        "dependsOn": [
          "categories",
          "settings"
        ]
      }
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "Шаблон тела: вложенный объект filter с массивом объектов {id_category, name}, статика active/currency и значения из набора settings (одна строка)."
    },
    {
      "type": "table",
      "dataKey": "prices",
      "columns": [
        {
          "field": "category",
          "title": "Категория"
        },
        {
          "field": "price",
          "title": "Цена",
          "format": "currency"
        },
        {
          "field": "currency",
          "title": "Валюта"
        },
        {
          "field": "updated",
          "title": "Обновлено"
        }
      ],
      "grandTotal": false
    }
  ]
}
