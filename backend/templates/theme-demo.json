{
  "version": 2,
  "id": "theme-demo",
  "title": "Темы: светлая и тёмная",
  "description": "Пример для приёмки тем (ADR-156): таблица и график следуют теме, блок с явными цветами — нет",
  "folder": "Примеры",
  "tags": [
    "тема",
    "оформление",
    "ADR-156"
  ],
  "params": [
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "year(*)",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "today(*)",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "sales": {
      "params": {
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT region, category, product, sum(amount)::bigint AS amount, sum(profit)::bigint AS profit FROM reports_examples.sales WHERE order_date >= :from::date AND order_date <= :to::date GROUP BY region, category, product ORDER BY region NULLS LAST, category NULLS LAST, product",
      "connection": "main"
    }
  },
  "blocks": [
    {
      "type": "text",
      "span": 12,
      "text": "Переключите тему в правом верхнем углу. Таблица и график ниже меняют оформление вместе с темой, потому что цвета в шаблоне не заданы; таблица «Явные цвета шаблона» выглядит одинаково в обеих темах — шаблон главнее (ADR-156). Печать всегда светлая."
    },
    {
      "type": "table",
      "dataKey": "sales",
      "span": 12,
      "collapsible": true,
      "grandTotal": true,
      "columns": [
        {
          "field": "region",
          "title": "Регион",
          "group": true,
          "subtotal": true
        },
        {
          "field": "category",
          "title": "Категория",
          "group": true
        },
        {
          "field": "product",
          "title": "Продукт"
        },
        {
          "title": "Финансы",
          "children": [
            {
              "field": "amount",
              "title": "Сумма",
              "type": "int",
              "aggregate": "sum",
              "format": "number"
            },
            {
              "field": "profit",
              "title": "Прибыль",
              "type": "int",
              "aggregate": "sum",
              "format": "number"
            }
          ]
        },
        {
          "title": "Рентабельность",
          "expression": "sum(profit) / sum(amount)",
          "format": "percent"
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "sales",
      "span": 6,
      "chartType": "bar",
      "title": "Сумма по регионам (цвета из темы)",
      "xField": "region",
      "yField": "amount",
      "aggregate": "sum",
      "height": 320
    },
    {
      "type": "table",
      "dataKey": "sales",
      "span": 6,
      "title": "Явные цвета шаблона (не меняются)",
      "styles": {
        "header": {
          "colors": {
            "background": "#1a4fa0",
            "text": "#ffffff"
          }
        },
        "grandtotal": {
          "colors": {
            "background": "#e8eef9",
            "text": "#1a4fa0"
          }
        }
      },
      "grandTotal": true,
      "columns": [
        {
          "field": "region",
          "title": "Регион",
          "group": true,
          "subtotal": true
        },
        {
          "field": "amount",
          "title": "Сумма",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        }
      ]
    }
  ]
}
