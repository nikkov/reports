{
  "version": 2,
  "id": "public-demo",
  "title": "Открытый отчёт: продажи по регионам",
  "description": "Публичный отчёт: открывается по прямой ссылке без входа (public: true)",
  "folder": "Примеры",
  "tags": [
    "публичный",
    "доступ"
  ],
  "public": true,
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "params": [
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "year(*)",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "*",
      "source": {
        "kind": "date"
      }
    }
  ],
  "datasets": {
    "sales": {
      "connection": "main",
      "params": {
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT r.name AS region, sum(s.amount) AS amount, count(*) AS deals FROM reports_examples.sales s JOIN reports_examples.regions r ON r.id = s.region_id WHERE s.order_date BETWEEN :from::date AND :to::date GROUP BY r.name ORDER BY amount DESC"
    }
  },
  "styles": {
    "preset": "default"
  },
  "blocks": [
    {
      "type": "text",
      "span": 12,
      "text": "Этот отчёт помечен `public: true` — он открывается по прямой ссылке без входа, роли доступа к нему не применяются. Период: {{from}} — {{to}}."
    },
    {
      "type": "table",
      "dataKey": "sales",
      "span": 12,
      "title": "Продажи по регионам",
      "height": 320,
      "grandTotal": true,
      "columns": [
        {
          "field": "region",
          "title": "Регион"
        },
        {
          "field": "amount",
          "title": "Сумма",
          "aggregate": "sum",
          "format": {
            "style": "number",
            "decimals": 0,
            "group": " "
          },
          "align": "right"
        },
        {
          "field": "deals",
          "title": "Заказов",
          "aggregate": "sum",
          "format": {
            "style": "integer"
          },
          "align": "right"
        }
      ]
    }
  ]
}
