{
  "version": 2,
  "id": "crm-paged",
  "title": "Постраничный REST-источник",
  "description": "REST отдаёт страницами: набор собирает их до лимита (ADR-104)",
  "folder": "Примеры",
  "tags": [
    "REST",
    "пагинация"
  ],
  "connections": {
    "crm": {
      "kind": "rest",
      "baseUrl": "${CRM_BASE_URL}",
      "headers": {
        "Accept": "application/json"
      },
      "timeoutMs": 5000
    }
  },
  "params": [],
  "datasets": {
    "rows": {
      "connection": "crm",
      "rest": {
        "path": "/api/rows",
        "rowsPath": "items",
        "page": {
          "param": "page",
          "sizeParam": "limit",
          "size": 1000,
          "maxPages": 5
        },
        "columns": [
          {
            "field": "id",
            "type": "int"
          },
          {
            "field": "name",
            "type": "text",
            "title": "Строка"
          }
        ]
      }
    }
  },
  "styles": {
    "preset": "default"
  },
  "blocks": [
    {
      "type": "table",
      "dataKey": "rows",
      "span": 12,
      "title": "Строки из REST",
      "height": 400,
      "columns": [
        {
          "field": "id",
          "title": "#",
          "align": "right"
        },
        {
          "field": "name",
          "title": "Строка"
        }
      ]
    }
  ]
}
