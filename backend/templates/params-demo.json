{
  "version": 2,
  "id": "params-demo",
  "title": "Демо параметров: справочники, мультивыбор, статический набор, даты",
  "description": "Синтетический пример со всеми поддерживаемыми способами получения значений параметров.",
  "params": [
    {
      "name": "region",
      "type": "select",
      "label": "Регион (справочник, ID→NAME)",
      "required": true,
      "source": {
        "kind": "lookup",
        "sql": "SELECT id::text AS value, name AS label FROM regions ORDER BY name"
      }
    },
    {
      "name": "category",
      "type": "select",
      "label": "Категории (мультивыбор, каскад)",
      "multiple": true,
      "source": {
        "kind": "lookup",
        "dependsOn": "region",
        "sql": "SELECT DISTINCT s.category AS value, s.category AS label FROM sales s WHERE s.region_id = :region::int AND s.category IS NOT NULL ORDER BY 1"
      }
    },
    {
      "name": "scope",
      "type": "select",
      "label": "Состав (статический набор)",
      "required": true,
      "default": "all",
      "source": {
        "kind": "static",
        "options": [
          {
            "value": "all",
            "label": "Все строки"
          },
          {
            "value": "profit_only",
            "label": "Только прибыльные"
          }
        ]
      }
    },
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2026-01-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-03-31",
      "source": {
        "kind": "date"
      }
    }
  ],
  "datasets": {
    "sales": {
      "params": {
        "region": "$region",
        "category": "$category",
        "from": "$from",
        "to": "$to",
        "scope": "$scope"
      },
      "sql": "SELECT s.region, s.category, s.product, s.amount, s.profit, s.order_date FROM sales s WHERE s.region_id = :region::int AND (:category = '' OR s.category = ANY(string_to_array(:category, ','))) AND s.order_date >= :from::date AND s.order_date <= :to::date AND (:scope = 'all' OR s.profit > 0) ORDER BY s.category NULLS LAST, s.product, s.id"
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "Регион: {{region}}. Категории: {{category}}. Состав: {{scope}}. Период: {{from}} — {{to}}"
    },
    {
      "type": "table",
      "dataKey": "sales",
      "grandTotal": true,
      "columns": [
        {
          "field": "category",
          "title": "Категория",
          "group": true,
          "subtotal": true
        },
        {
          "field": "product",
          "title": "Продукт"
        },
        {
          "field": "amount",
          "title": "Сумма",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "profit",
          "title": "Прибыль",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Рентабельность",
          "expression": "sum(profit) / sum(amount)",
          "format": "percent"
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "sales",
      "chartType": "bar",
      "title": "Сумма по выбранным категориям",
      "xField": "category",
      "yField": "amount",
      "aggregate": "sum",
      "width": "half"
    },
    {
      "type": "chart",
      "dataKey": "sales",
      "chartType": "pie",
      "title": "Доля продуктов в сумме",
      "xField": "product",
      "yField": "amount",
      "aggregate": "sum",
      "width": "half"
    }
  ],
  "folder": "Демо",
  "tags": [
    "параметры",
    "пример"
  ]
}
