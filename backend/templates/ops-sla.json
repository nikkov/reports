{
  "version": 2,
  "id": "ops-sla",
  "title": "Операции: нагрузка и отказы по сервисам",
  "description": "Двухуровневая группировка сервис → команда, доля отказов, среднее время ответа, динамика по дням.",
  "params": [
    {
      "name": "service",
      "type": "select",
      "label": "Сервис",
      "source": {
        "kind": "lookup",
        "sql": "SELECT '' AS value, 'Все сервисы' AS label UNION ALL SELECT DISTINCT o.service, o.service FROM reports_examples.ops o ORDER BY 2",
        "connection": "main"
      }
    },
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2026-01-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-03-31",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "ops": {
      "params": {
        "service": "$service",
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT o.day, o.service, o.team, o.requests, o.failures, o.avg_ms FROM reports_examples.ops o WHERE o.day >= :from::date AND o.day <= :to::date AND (:service = '' OR o.service = :service) ORDER BY o.day, o.service, o.id",
      "connection": "main"
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "{{service}}. Период: {{from}} — {{to}}"
    },
    {
      "type": "table",
      "dataKey": "ops",
      "collapsible": true,
      "grandTotal": true,
      "nullText": "нет данных",
      "columns": [
        {
          "field": "service",
          "title": "Сервис",
          "group": true,
          "subtotal": true
        },
        {
          "field": "team",
          "title": "Команда",
          "group": true,
          "subtotal": true
        },
        {
          "field": "requests",
          "title": "Запросы",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "failures",
          "title": "Отказы",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Доля отказов",
          "expression": "sum(failures) / sum(requests)",
          "format": "percent",
          "decimals": 2,
          "width": 130
        },
        {
          "field": "avg_ms",
          "title": "Среднее, мс",
          "type": "int",
          "aggregate": "avg",
          "decimals": 0,
          "width": 120
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "ops",
      "chartType": "line",
      "title": "Запросы по дням",
      "xField": "day",
      "yField": "requests",
      "aggregate": "sum",
      "width": "full"
    },
    {
      "type": "chart",
      "dataKey": "ops",
      "chartType": "bar",
      "title": "Отказы по сервисам в разрезе команд",
      "xField": "service",
      "yField": "failures",
      "seriesField": "team",
      "aggregate": "sum",
      "width": "full"
    }
  ],
  "folder": "Операции",
  "tags": [
    "SLA",
    "дашборд"
  ],
  "refreshSeconds": 30
}
