{
  "version": 2,
  "id": "finance-plan-fact",
  "title": "Финансы: план и факт по центрам затрат",
  "description": "Помесячное исполнение бюджета: план, факт, отклонение и процент исполнения по счетам.",
  "accessRoles": [
    "finance"
  ],
  "params": [
    {
      "name": "cost_center",
      "type": "select",
      "label": "Центр затрат",
      "default": "",
      "emptyOption": {
        "value": "",
        "label": "Все центры"
      },
      "source": {
        "kind": "lookup",
        "dataset": "cost_center_lookup"
      }
    },
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2025-10-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-02-28",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "finance": {
      "params": {
        "cost_center": "$cost_center",
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT f.period, f.cost_center, f.account, f.plan_amount, f.fact_amount FROM reports_examples.finance f WHERE f.period >= :from::date AND f.period <= :to::date AND (:cost_center = '' OR f.cost_center = :cost_center) ORDER BY f.period, f.account, f.id",
      "connection": "main"
    },
    "cost_center_lookup": {
      "connection": "main",
      "sql": "SELECT DISTINCT f.cost_center AS value, f.cost_center AS label FROM reports_examples.finance f WHERE f.cost_center IS NOT NULL ORDER BY 1"
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "{{cost_center}}. Период: {{from}} — {{to}}"
    },
    {
      "type": "table",
      "dataKey": "finance",
      "collapsible": true,
      "grandTotal": true,
      "columns": [
        {
          "field": "period",
          "title": "Месяц",
          "group": true,
          "subtotal": true,
          "type": "date"
        },
        {
          "field": "account",
          "title": "Счёт"
        },
        {
          "field": "plan_amount",
          "title": "План",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "fact_amount",
          "title": "Факт",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Отклонение",
          "expression": "sum(fact_amount) - sum(plan_amount)",
          "format": "number",
          "width": 130
        },
        {
          "title": "Исполнение",
          "expression": "sum(fact_amount) / sum(plan_amount)",
          "format": "percent",
          "decimals": 1,
          "width": 120
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "finance",
      "chartType": "bar",
      "title": "Факт по счетам",
      "xField": "account",
      "yField": "fact_amount",
      "aggregate": "sum",
      "width": "full"
    }
  ],
  "folder": "Финансы",
  "tags": [
    "план-факт",
    "группировка"
  ]
}
