{
  "version": 2,
  "id": "ops-dark",
  "title": "Операции: нагрузка и отказы (тёмная тема)",
  "description": "Тёмное оформление с зеброй и собственными цветами зон: шапка, строки, подытоги и итог стилизуются независимо.",
  "params": [
    {
      "name": "service",
      "type": "select",
      "label": "Сервис",
      "source": {
        "kind": "lookup",
        "sql": "SELECT '' AS value, 'Все сервисы' AS label UNION ALL SELECT DISTINCT o.service, o.service FROM reports_examples.ops o ORDER BY 2",
        "connection": "main"
      }
    },
    {
      "name": "from",
      "type": "date",
      "label": "Период с",
      "required": true,
      "default": "2026-01-01",
      "source": {
        "kind": "date"
      }
    },
    {
      "name": "to",
      "type": "date",
      "label": "по",
      "required": true,
      "default": "2026-03-31",
      "source": {
        "kind": "date"
      }
    }
  ],
  "connections": {
    "main": {
      "kind": "postgres",
      "host": "${PGHOST}",
      "port": "${PGPORT}",
      "database": "${PGDATABASE}",
      "user": "${REP_RO_DB_USER}",
      "passwordEnv": "REP_RO_DB_PASSWORD",
      "schema": "reports_examples",
      "sslmode": "prefer",
      "connectTimeout": 5,
      "statementTimeoutMs": 5000
    }
  },
  "datasets": {
    "ops": {
      "params": {
        "service": "$service",
        "from": "$from",
        "to": "$to"
      },
      "sql": "SELECT o.day, o.service, o.team, o.requests, o.failures, o.avg_ms FROM reports_examples.ops o WHERE o.day >= :from::date AND o.day <= :to::date AND (:service = '' OR o.service = :service) ORDER BY o.day, o.service, o.id",
      "connection": "main"
    }
  },
  "styles": {
    "preset": "dark",
    "font": {
      "size": 12,
      "family": "Inter"
    },
    "layout": {
      "rowHeight": 24,
      "headerHeight": 30,
      "subtotalHeight": 26,
      "grandtotalHeight": 30,
      "cellPadding": "2px 8px",
      "zebra": true,
      "stripeColor": "#1b222c",
      "borders": "horizontal"
    },
    "header": {
      "font": {
        "weight": 700
      },
      "colors": {
        "text": "#9fc4ff",
        "background": "#232c38"
      }
    },
    "subtotal": {
      "colors": {
        "text": "#cfe0f5",
        "background": "#1f2732"
      }
    },
    "grandtotal": {
      "font": {
        "weight": 800
      },
      "colors": {
        "text": "#ffffff",
        "background": "#2b3644"
      }
    },
    "columns": {
      "failures": {
        "colors": {
          "text": "#ff9a9a"
        },
        "align": "right"
      },
      "requests": {
        "width": 120,
        "align": "right"
      }
    }
  },
  "blocks": [
    {
      "type": "text",
      "text": "{{service}}. Период: {{from}} — {{to}}"
    },
    {
      "type": "table",
      "dataKey": "ops",
      "collapsible": true,
      "grandTotal": true,
      "columns": [
        {
          "field": "service",
          "title": "Сервис",
          "group": true,
          "subtotal": true
        },
        {
          "field": "team",
          "title": "Команда",
          "group": true,
          "subtotal": true
        },
        {
          "field": "requests",
          "title": "Запросы",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "field": "failures",
          "title": "Отказы",
          "type": "int",
          "aggregate": "sum",
          "format": "number"
        },
        {
          "title": "Доля отказов",
          "expression": "sum(failures) / sum(requests)",
          "format": "percent",
          "decimals": 2,
          "width": 130
        },
        {
          "field": "avg_ms",
          "title": "Среднее, мс",
          "type": "int",
          "aggregate": "avg",
          "decimals": 0,
          "width": 120
        }
      ]
    },
    {
      "type": "chart",
      "dataKey": "ops",
      "chartType": "line",
      "title": "Запросы по дням",
      "xField": "day",
      "yField": "requests",
      "aggregate": "sum",
      "width": "full"
    }
  ],
  "folder": "Операции",
  "tags": [
    "стили",
    "пример"
  ]
}
