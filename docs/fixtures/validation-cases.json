        "blocks": [
          {
            "type": "text",
            "text": "Период {{from}}"
          },
          {
            "type": "table",
            "dataKey": "sales",
            "columns": [
              {
                "field": "x",
                "title": "X"
              }
            ]
          }
        ]
      },
      "errors": []
    },
