{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rep.local/template.schema.json",
  "title": "Report template v1",
  "description": "Декларативное описание отчёта: параметры, наборы данных, блоки (текст/таблица/диаграмма).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "blocks"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "params": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/param"
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dataset"
      }
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "param": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "type": {
          "enum": [
            "date",
            "datetime",
            "int",
            "float",
            "text",
            "bool",
            "select"
          ]
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "date",
                "datetime",
                "static",
                "lookup"
              ]
            },
            "queryId": {
              "type": "string",
              "minLength": 1
            },
            "options": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "value",
                  "label"
                ],
                "properties": {
                  "value": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            },
            "dependsOn": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "multiple": {
          "type": "boolean"
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queryId"
      ],
      "properties": {
        "queryId": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "boolean"
        },
        "subtotal": {
          "type": "boolean"
        },
        "aggregate": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "countDistinct"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": [
            "number",
            "percent",
            "currency",
            "date",
            "integer"
          ]
        },
        "type": {
          "enum": [
            "int",
            "float",
            "text",
            "date",
            "bool"
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "width": {
          "type": "integer",
          "minimum": 40
        },
        "align": {
          "enum": [
            "left",
            "right",
            "center"
          ]
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "textBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "enum": [
            "full",
            "half"
          ]
        }
      }
    },
    "tableBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "dataKey",
        "columns"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "dataKey": {
          "type": "string",
          "minLength": 1
        },
        "collapsible": {
          "type": "boolean"
        },
        "grandTotal": {
          "type": "boolean"
        },
        "nullText": {
          "type": "string"
        },
        "width": {
          "enum": [
            "full",
            "half"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        }
      }
    },
    "chartBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "dataKey",
        "chartType",
        "xField",
        "yField"
      ],
      "properties": {
        "type": {
          "const": "chart"
        },
        "dataKey": {
          "type": "string",
          "minLength": 1
        },
        "chartType": {
          "enum": [
            "line",
            "bar",
            "pie"
          ]
        },
        "xField": {
          "type": "string",
          "minLength": 1
        },
        "yField": {
          "type": "string",
          "minLength": 1
        },
        "seriesField": {
          "type": "string"
        },
        "aggregate": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "countDistinct"
          ]
        },
        "title": {
          "type": "string"
        },
        "width": {
          "enum": [
            "full",
            "half"
          ]
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/textBlock"
        },
        {
          "$ref": "#/$defs/tableBlock"
        },
        {
          "$ref": "#/$defs/chartBlock"
        }
      ]
    }
  }
}
